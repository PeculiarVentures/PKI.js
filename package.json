{
  "name": "pkijs",
  "version": "3.4.0",
  "description": "Public Key Infrastructure (PKI) is the basis of how identity and key management is performed on the web today. PKIjs is a pure JavaScript library implementing the formats that are used in PKI applications. It is built on WebCrypto and aspires to make it possible to build native web applications that utilize X.509 and the related formats on the web without plug-ins",
  "keywords": [
    "ES2015",
    "ES6",
    "OCSP",
    "PKCS",
    "Web Cryptography API",
    "WebCrypto",
    "X.509",
    "certificate",
    "cms",
    "crl",
    "encrypted",
    "enveloped",
    "timestamp"
  ],
  "license": "BSD-3-Clause",
  "author": {
    "name": "Yury Strozhevsky",
    "email": "yury@strozhevsky.com"
  },
  "contributors": [
    {
      "email": "rmh@unmitigatedrisk.com",
      "name": "Ryan Hurst"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/PeculiarVentures/PKI.js.git"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "main": "./build/cjs/index.js",
  "module": "./build/mjs/index.js",
  "types": "./build/types/index.d.ts",
  "scripts": {
    "prebuild": "rm -rf build",
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/fix-esm-imports.mjs && tsc -p tsconfig.types.json && echo '{\"type\":\"module\"}' > build/mjs/package.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "asn1js": "^3.0.10",
    "bytestreamjs": "^2.0.1",
    "pvtsutils": "^1.3.6",
    "pvutils": "^1.1.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@peculiar/webcrypto": "^1.7.1",
    "@types/node": "^20.19.21",
    "@vitest/coverage-v8": "^4.0.16",
    "emailjs-mime-builder": "^2.0.5",
    "emailjs-mime-parser": "^2.0.7",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.16"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.15.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.5.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
