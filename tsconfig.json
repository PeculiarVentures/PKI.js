{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noErrorTruncation": true,
    "noEmit": true,
    "useDefineForClassFields": false
  },
  "include": ["src", "*.config.ts", "vitest.setup.ts"]
}
